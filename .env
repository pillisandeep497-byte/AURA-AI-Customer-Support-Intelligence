```dotenv
# Supabase Database
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVER_SIDE_KEY

# OpenRouter AI Model
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openai/gpt-oss-20b

# AURA API Authentication
# Leave blank for local testing without API-key protection
AURA_API_KEY=

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval Settings
TOP_K=5
```
